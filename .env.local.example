# ---------------------------------------------------------------------------
# .env.local.example  —  TEMPLATE ONLY. No real values here (this file is committed).
# Put actual secrets in .env.local (git-ignored) and in the Vercel dashboard.
# ---------------------------------------------------------------------------

# --- What the deployed app actually reads (prod) ---
NEON_PRIMARY_URL=postgres://user:password@host.neon.tech/neondb
NEON_MEMORY_URL=postgres://user:password@host.neon.tech/neondb
OLLAMA_EMBED_URL=https://your-ollama-endpoint
OLLAMA_EMBED_TOKEN=your-embed-token
NEXUS_LLM_API_KEY=your-llm-api-key

# --- Auth (Clerk) — only needed when the owner-gate is wired ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_live_publishable_key
CLERK_SECRET_KEY=sk_test_or_live_secret_key
OWNER_CLERK_USER_ID=user_owner_id_from_clerk

# --- Encryption (used by src/lib/integrations/crypto.ts) ---
# ENCRYPTION_KEY MUST be a base64-encoded 32-byte key (AES-256-GCM):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=base64-32-byte-key
SECRET_KEY=base64-32-byte-key
NEXTAUTH_SECRET=random-hex-secret

# --- Environment ---
NODE_ENV=production
VERCEL_ENV=production

# --- Minecraft local control (PC runtime only; never add these to Vercel) ---
# `npm run dev:local` generates an ephemeral 32-byte token and supplies these automatically.
MASTERMIND_LOCAL_CONTROL_ENABLED=false
MASTERMIND_CONTROL_URL=http://127.0.0.1:43100
MASTERMIND_CONTROL_TOKEN=generate-at-least-32-random-characters
# This file is loaded by Next after the local supervisor starts; changing this value here
# alone does not enable the supervised agent. Once memory migrations 001 and 002 are applied, create and
# inspect a non-mutating, non-overwriting bootstrap plan from PowerShell:
#   npm run memory:identity:plan -- --out "$PWD\family-identity-bootstrap.json"
# Apply that exact plan once through the supervisor (it retains the plan, prints the service UUID,
# and stops; its ephemeral bearer is never put in the plan, command line, or output):
#   npm run dev:local -- --family-identity-bootstrap "$PWD\family-identity-bootstrap.json"
# Bootstrap cannot run with a player binding or memory sync. After it stops, launch separately with:
#   $env:MASTERMIND_MEMORY_PLAYER_ID='<canonical-player-uuid>'
#   npm run dev:local -- --memory-event-sync
# An exact true inherited in the supervisor process environment is also accepted. The endpoint
# is fixed at http://127.0.0.1:3000/api/memory/events and reuses MASTERMIND_CONTROL_TOKEN.
MASTERMIND_MEMORY_EVENT_SYNC_ENABLED=false
# Documentation-only placeholder: this value must be inherited by the supervisor; editing this
# file alone cannot bind the already-started control-plane process.
# MASTERMIND_MEMORY_PLAYER_ID=00000000-0000-8000-8000-000000000000
# Parent-only memory console (Next runtime only).
# Apply memory migration 003 after 001 and 002 before enabling this console.
# This private-PC build already contains the salted verifier for family code 795200 and the
# parent UUID used by the retained bootstrap plan. These optional server-only overrides are
# available for a future PIN rotation or a different parent identity; they are not required.
# `npm run memory:operator:pin` can generate a replacement verifier without contacting a service.
# When copying its line, keep the backslashes so Next's env loader preserves literal dollar signs.
# MASTERMIND_MEMORY_OPERATOR_PIN_SCRYPT=v1\$base64url-salt\$base64url-scrypt-digest
# MASTERMIND_MEMORY_OPERATOR_PLAYER_ID=00000000-0000-8000-8000-000000000000
# MASTERMIND_MEMORY_HOUSEHOLD_ID=family-local
# Local desktop Context Gateway. It reuses the parent identity above and never
# needs an OpenAI API key; ChatGPT/Codex starts it as a local STDIO MCP process.
MASTERMIND_EMBED_MODEL=nomic-embed-text
# Obsidian export is one-way, generated-only, and disabled until both values
# are set deliberately. Use an absolute vault path, never a drive root.
MASTERMIND_OBSIDIAN_EXPORT_ENABLED=false
# MASTERMIND_OBSIDIAN_VAULT=C:\Users\you\Documents\Mastermind Vault
# Java is resolved from Mojang's per-release runtime metadata and managed locally.
# This legacy fallback is used only by imported records that do not yet carry a pinned runtime.
MASTERMIND_JAVA_EXECUTABLE=java
# Optional: defaults to %LOCALAPPDATA%\Mastermind\minecraft on Windows.
# MASTERMIND_MINECRAFT_DATA_DIR=C:\path\to\private\mastermind-minecraft-data
