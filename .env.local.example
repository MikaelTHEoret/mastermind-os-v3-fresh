# Template only. Put actual values in ignored .env.local or the deployment settings.
# Required for private hosted UI/API owner access. Missing configuration fails closed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
OWNER_CLERK_USER_ID=

# Canonical memory database and owner binding; use the existing authorized household/operator.
NEON_MEMORY_URL=
MASTERMIND_MEMORY_HOUSEHOLD_ID=
MASTERMIND_MEMORY_OPERATOR_PLAYER_ID=
# The canonical operator record must bind the owner's Clerk subject.
# OAuth discovery uses the configured Clerk instance. Register ChatGPT and Codex clients
# in that instance; their client credentials belong in Clerk/client settings, not this file.

# Optional existing domains/providers; fill only for the operations you enable.
NEON_PRIMARY_URL=
OLLAMA_EMBED_URL=
OLLAMA_EMBED_TOKEN=
NEXUS_LLM_API_KEY=
OPENAI_API_KEY=
# Base64 32-byte AES-256-GCM key for stored integration secrets.
ENCRYPTION_KEY=
SECRET_KEY=
NEXTAUTH_SECRET=

# Local capture and local compute/control routes require the private loopback service.
# They remain unavailable on Vercel. The platform supplies NODE_ENV/VERCEL_ENV.
