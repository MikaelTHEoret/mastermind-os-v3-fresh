{
  "name": "mastermind-os-v3-fresh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:local": "node scripts/run-local-control.mjs",
    "start:local": "node scripts/run-local-control.mjs --production",
    "node:host:install": "node scripts/install-windows-node-host.mjs",
    "memory:identity:plan": "node scripts/family-identity-bootstrap.mjs",
    "memory:migrate": "node scripts/apply-memory-migrations.mjs",
    "minecraft:adopt-legacy-update-terminal": "node scripts/adopt-legacy-update-terminal.mjs",
    "memory:operator:pin": "node scripts/memory-operator-pin.mjs",
    "context:mcp": "node services/mastermind-context-gateway/src/mcp-server.mjs",
    "context:test": "node --test services/mastermind-context-gateway/test/*.test.mjs",
    "minecraft:agent": "node -e \"console.error('Use npm run dev:local so the authenticated supervisor owns safe Minecraft shutdown.'); process.exit(1)\"",
    "minecraft:test": "node --test services/minecraft-control-plane/test/*.test.mjs",
    "local-control:test": "node --test scripts/test/*.test.mjs",
    "lint": "next lint",
    "mcp:setup": "node scripts/setup-mastermind-context-mcp.mjs",
    "mcp:server": "npm run context:mcp",
    "mcp:test": "npm run context:test"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.12",
    "@neondatabase/serverless": "^1.0.1",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.14",
    "@types/three": "^0.184.1",
    "@vercel/analytics": "^1.3.1",
    "@vercel/speed-insights": "^1.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.263.1",
    "next": "^15.5.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sass": "^1.81.0",
    "semver": "^7.8.1",
    "tailwind-merge": "^2.2.0",
    "three": "^0.184.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "18.3.31",
    "@types/react-dom": "^18",
    "@types/ws": "^8.5.10",
    "autoprefixer": "^10.4.16",
    "eslint": "^8",
    "eslint-config-next": "15.1.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
