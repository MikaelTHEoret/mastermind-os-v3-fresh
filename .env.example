# =============================================================================
# 🧠 MASTERMIND OS v3 - ENVIRONMENT VARIABLES EXAMPLE
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# This example file is safe to commit and shows the required structure

# =============================================================================
# 🗄️ DATABASE CONFIGURATION - NEON PostgreSQL
# =============================================================================
DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"
POSTGRES_URL="postgres://username:password@host:5432/database"
POSTGRES_HOST="your-neon-host.neon.tech"
POSTGRES_USER="your_username"
POSTGRES_PASSWORD="your_password"
POSTGRES_DATABASE="your_database"

# =============================================================================
# 🔐 AUTHENTICATION & SECURITY - STACK AUTH
# =============================================================================
NEXT_PUBLIC_STACK_PROJECT_ID="your-stack-project-id"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="pck_your_publishable_key"
STACK_SECRET_SERVER_KEY="ssk_your_secret_server_key"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# =============================================================================
# 🔑 ENCRYPTION & SECRETS
# =============================================================================
ENCRYPTION_KEY="your-32-char-encryption-key"
SECRET_KEY="your-secret-key-for-app"

# =============================================================================
# 🌐 DEVELOPMENT ENVIRONMENT
# =============================================================================
NODE_ENV="development"
VERCEL_ENV="development"

# =============================================================================
# 🚀 OPTIONAL API CONFIGURATIONS
# =============================================================================
# Blockchain & Web3
ETHEREUM_RPC_URL="https://your-ethereum-rpc-provider"
SCROLL_RPC_URL="https://your-scroll-rpc-provider"

# IPFS/Pinata
PINATA_JWT="your-pinata-jwt-token"
PINATA_GATEWAY_URL="https://your-pinata-gateway.com"

# GitHub Integration
GITHUB_TOKEN="ghp_your_github_personal_access_token"

# OpenAI/AI Services
OPENAI_API_KEY="sk-your-openai-api-key"

# =============================================================================
# 📊 ANALYTICS & MONITORING
# =============================================================================
ANALYTICS_ID="your-analytics-id"
SENTRY_DSN="https://your-sentry-dsn"

# =============================================================================
# 🔧 BUILD & DEPLOYMENT SETTINGS
# =============================================================================
SKIP_TYPE_CHECK="true"
SKIP_LINT="true"
ANALYZE="false"

# =============================================================================
# 💡 SETUP INSTRUCTIONS
# =============================================================================
# 1. Copy this file to .env.local
# 2. Replace all placeholder values with your actual credentials
# 3. Never commit .env.local to version control
# 4. Use the env-config.ts utility to access these values in your app
# =============================================================================
