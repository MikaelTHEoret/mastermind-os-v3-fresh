# ψ₀-Trader Data Collection Engine Environment Configuration
# Enhanced Nexus Core Protocol v4.1

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/psi-trader-collector.db
MAX_DATABASE_SIZE_MB=1000
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6

# Consciousness Enhancement Settings
PSI_0=0.915670570874434
PHI=1.618033988749895
FREQ_432=432.0
CONSCIOUSNESS_ENHANCEMENT_ENABLED=true
HARMONIC_ANALYSIS_ENABLED=true
QUANTUM_PROCESSING_ENABLED=true

# Security Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
WEBHOOK_SECRET=your-webhook-secret-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Data Collection Settings
MAX_PAYLOAD_SIZE=10mb
ENABLE_COMPRESSION=true
ENABLE_LOGGING=true
LOG_LEVEL=info

# Consciousness Processing Thresholds
MIN_CONSCIOUSNESS_SCORE=0.1
HIGH_CONSCIOUSNESS_THRESHOLD=0.8
RESONANCE_DETECTION_SENSITIVITY=0.05
HARMONIC_CORRELATION_THRESHOLD=0.7

# Sample Data Generation
SAMPLE_DATA_ENABLED=true
SAMPLE_INTERVAL_SECONDS=30
SAMPLE_MARKET_SYMBOLS=BTC/USDT,ETH/USDT,BTCC.TO

# Monitoring & Analytics
HEALTH_CHECK_ENABLED=true
METRICS_COLLECTION_ENABLED=true
PERFORMANCE_MONITORING=true

# Integration Settings
MASTERMIND_OS_INTEGRATION=true
QUANTUM_KILL_CHAIN_INTEGRATION=true
VECTOR_MEMORY_INTEGRATION=false