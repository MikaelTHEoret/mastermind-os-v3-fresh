{
  "schemaVersion": 1,
  "id": "mastermind-family-agent-bridge",
  "version": "${version}",
  "name": "Mastermind Family Agent Bridge",
  "description": "Authenticated local control bridge for the isolated Minecraft Family Agent.",
  "authors": ["Mikael"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mastermind.minecraft.familyagent.client.FamilyAgentBridgeClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=0.157.0",
    "minecraft": "=26.2",
    "java": ">=25"
  },
  "suggests": {
    "baritone": "*"
  }
}

