@@ -109,7 +110,11 @@ private void tick() {
             long before = System.currentTimeMillis();
             EVENT_BUS.post(ClientTickEvent.INSTANCE);
             if (doBotTicks.get()) {
-                EVENT_BUS.post(ClientBotTick.INSTANCE);
