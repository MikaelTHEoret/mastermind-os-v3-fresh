@@ -0,0 +1,17 @@
+package com.zenith.event.client;
+
+/**
+ * Synchronous fail-closed extension point posted immediately before native bot work.
+ * Stock behavior remains allowed unless a subscriber explicitly denies the tick.
+ */
+public final class NativeBotTickAdmissionEvent {
+    private boolean denied;
+
+    public void deny() {
+        denied = true;
+    }
+
+    public boolean isDenied() {
+        return denied;
+    }
+}
