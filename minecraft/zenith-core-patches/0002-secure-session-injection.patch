+package com.zenith.network.client;
+
+import java.util.Optional;
+import java.util.UUID;
+import java.util.regex.Pattern;
+
+final class MastermindInjectedSession {
+    static final String USERNAME_PROPERTY = "mastermind.zenith.session.username";
+    static final String UUID_PROPERTY = "mastermind.zenith.session.uuid";
+    static final String ACCESS_TOKEN_PROPERTY = "mastermind.zenith.session.accessToken";
+    static final String REQUIRED_PROPERTY = "mastermind.zenith.session.required";
+
+    private static final Pattern USERNAME = Pattern.compile("[A-Za-z0-9_]{1,16}");
+    private static final Pattern ACCESS_TOKEN = Pattern.compile("[\\x21-\\x7e]{16,24576}");
+
+    private MastermindInjectedSession() {}
+
+    static Optional<Value> take() {
+        String username = System.getProperty(USERNAME_PROPERTY);
+        String uuid = System.getProperty(UUID_PROPERTY);
+        String accessToken = System.getProperty(ACCESS_TOKEN_PROPERTY);
+        try {
+            if (username == null && uuid == null && accessToken == null) {
+                if (Boolean.parseBoolean(System.getProperty(REQUIRED_PROPERTY))) {
+                    throw new IllegalStateException("The required Mastermind Minecraft session is no longer available");
+                }
+                return Optional.empty();
+            }
+            if (username == null || uuid == null || accessToken == null || !USERNAME.matcher(username).matches()
+                || !ACCESS_TOKEN.matcher(accessToken).matches()) {
+                throw new IllegalStateException("The injected Mastermind Minecraft session is invalid");
+            }
+            final UUID profileId;
+            try {
+                profileId = UUID.fromString(uuid);
+            } catch (RuntimeException error) {
+                throw new IllegalStateException("The injected Mastermind Minecraft session is invalid");
+            }
+            return Optional.of(new Value(username, profileId, accessToken));
+        } finally {
+            System.clearProperty(USERNAME_PROPERTY);
+            System.clearProperty(UUID_PROPERTY);
+            System.clearProperty(ACCESS_TOKEN_PROPERTY);
+        }
+    }
+
+    record Value(String username, UUID uuid, String accessToken) {}
+}
