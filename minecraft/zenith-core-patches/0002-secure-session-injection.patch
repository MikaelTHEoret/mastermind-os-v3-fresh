@@ -0,0 +1,52 @@
+package com.zenith.network.client;
+
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+class MastermindInjectedSessionTest {
+    @AfterEach
+    void clearProperties() {
+        System.clearProperty(MastermindInjectedSession.USERNAME_PROPERTY);
+        System.clearProperty(MastermindInjectedSession.UUID_PROPERTY);
+        System.clearProperty(MastermindInjectedSession.ACCESS_TOKEN_PROPERTY);
+        System.clearProperty(MastermindInjectedSession.REQUIRED_PROPERTY);
+    }
+
+    @Test
+    void absentSessionDoesNotChangeNormalAuthentication() {
+        assertFalse(MastermindInjectedSession.take().isPresent());
+    }
+
+    @Test
+    void consumesAndClearsCompleteSession() {
+        System.setProperty(MastermindInjectedSession.USERNAME_PROPERTY, "The_AlChemist___");
+        System.setProperty(MastermindInjectedSession.UUID_PROPERTY, "996a56dd-fb3c-4f90-9158-1a608652ec77");
+        System.setProperty(MastermindInjectedSession.ACCESS_TOKEN_PROPERTY, "safe-test-token-1234567890");
+
+        var value = MastermindInjectedSession.take().orElseThrow();
+
+        assertEquals("The_AlChemist___", value.username());
+        assertEquals("996a56dd-fb3c-4f90-9158-1a608652ec77", value.uuid().toString());
+        assertFalse(MastermindInjectedSession.take().isPresent());
+    }
+
+    @Test
+    void partialSessionFailsClosedAndClearsEveryProperty() {
+        System.setProperty(MastermindInjectedSession.USERNAME_PROPERTY, "The_AlChemist___");
+        System.setProperty(MastermindInjectedSession.ACCESS_TOKEN_PROPERTY, "safe-test-token-1234567890");
+
+        assertThrows(IllegalStateException.class, MastermindInjectedSession::take);
+        assertFalse(MastermindInjectedSession.take().isPresent());
+    }
+
+    @Test
+    void requiredSessionCannotFallBackToNormalAuthenticationAfterConsumption() {
+        System.setProperty(MastermindInjectedSession.REQUIRED_PROPERTY, "true");
+
+        assertThrows(IllegalStateException.class, MastermindInjectedSession::take);
+    }
+}
