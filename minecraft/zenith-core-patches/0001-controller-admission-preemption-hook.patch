diff --git a/src/test/java/com/zenith/event/player/ControllerAdmissionEventTest.java b/src/test/java/com/zenith/event/player/ControllerAdmissionEventTest.java
new file mode 100644
index 0000000..f04278b
--- /dev/null
+++ b/src/test/java/com/zenith/event/player/ControllerAdmissionEventTest.java
@@ -0,0 +1,26 @@
+package com.zenith.event.player;
+
+import org.geysermc.mcprotocollib.auth.GameProfile;
+import org.junit.jupiter.api.Test;
+
+import java.util.UUID;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+final class ControllerAdmissionEventTest {
+    @Test
+    void preemptionIsDeniedUntilASynchronousSubscriberExplicitlyAllowsIt() {
+        var candidate = new GameProfile(UUID.fromString("22222222-2222-4222-8222-222222222222"), "parent");
+        var current = new GameProfile(UUID.fromString("11111111-1111-4111-8111-111111111111"), "service");
+        var event = new ControllerAdmissionEvent(candidate, current);
+
+        assertEquals(candidate, event.candidateProfile());
+        assertEquals(current, event.currentProfile());
+        assertFalse(event.isPreemptionAllowed());
+
+        event.allowPreemption();
+        assertTrue(event.isPreemptionAllowed());
+    }
+}
