+package com.zenith.event.player;
+
+import org.geysermc.mcprotocollib.auth.GameProfile;
+
+/**
+ * Fired synchronously after the candidate controller has authenticated and passed Zenith's
+ * whitelist, but before Zenith rejects it because another controller already owns the body.
+ * Preemption is denied unless a subscriber explicitly allows it.
+ */
+public final class ControllerAdmissionEvent {
+    private final GameProfile candidateProfile;
+    private final GameProfile currentProfile;
+    private boolean preemptionAllowed;
+
+    public ControllerAdmissionEvent(GameProfile candidateProfile, GameProfile currentProfile) {
+        this.candidateProfile = candidateProfile;
+        this.currentProfile = currentProfile;
+    }
+
+    public GameProfile candidateProfile() {
+        return candidateProfile;
+    }
+
+    public GameProfile currentProfile() {
+        return currentProfile;
+    }
+
+    public boolean isPreemptionAllowed() {
+        return preemptionAllowed;
+    }
+
+    public void allowPreemption() {
+        preemptionAllowed = true;
+    }
+}
