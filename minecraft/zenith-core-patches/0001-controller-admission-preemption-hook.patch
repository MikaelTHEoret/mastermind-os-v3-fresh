@@ -211 +209,25 @@ private boolean tryControllerLogin(ServerSession session, GameProfile clientGame
-        return false;
+
+        var currentSession = currentPlayer.get();
+        if (currentSession == null) return false;
+        var currentProfile = currentSession.getProfileCache().getProfile();
+        if (currentProfile == null) return false;
+
+        var admissionEvent = new ControllerAdmissionEvent(clientGameProfile, currentProfile);
+        EVENT_BUS.post(admissionEvent);
+        if (!admissionEvent.isPreemptionAllowed()) return false;
+
+        // Revoke packet forwarding before publishing the new lease. The old session's later
+        // disconnect compare-and-set cannot clear the candidate after this exact replacement.
