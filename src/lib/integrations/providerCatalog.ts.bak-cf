// src/lib/integrations/providerCatalog.ts
// Client-safe metadata (NO secrets). The "wrap the line around the key" intelligence:
// given a provider + the raw value the operator pastes, the system knows the env-var name,
// the storage target, the validation rule, and how to construct the final line/file.

export type IntegrationTarget = "app" | "local" | "serverless";
export type IntegrationCategory =
  | "llm" | "compute" | "database" | "auth" | "storage" | "search" | "devops" | "comms" | "custom";

export interface ProviderField {
  envKey: string;            // canonical env var name, e.g. OPENAI_API_KEY
  label: string;             // human label for the input
  secret: boolean;           // mask in UI + encrypt at rest
  pattern?: string;          // regex string for format validation (empty = no check)
  placeholder?: string;
}

export interface Provider {
  id: string;
  label: string;
  category: IntegrationCategory;
  target: IntegrationTarget; // app = encrypted DB; local = OS-standard path; serverless = deploy env
  fields: ProviderField[];
  osPath?: string;           // for local/serverless: where it lands on the operator machine (devlog #105)
  docs?: string;
  note?: string;
}

const sk = (p: string) => "^" + p + "[A-Za-z0-9_\\-]{16,}$";

