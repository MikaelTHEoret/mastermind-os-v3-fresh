export function getProvider(id: string): Provider | undefined {
  return PROVIDERS.find(p => p.id === id);
}

// Construct the exact line/representation that wraps the raw value -- shown as a live preview
// and used for storage. For app: KEY=value. For local osPath: a file/env directive.
export function constructLine(envKey: string, value: string): string {
  return envKey + "=" + value;
}

export function validateField(field: ProviderField, value: string): string | null {
  if (!value) return field.secret ? "Value is required" : null;
  if (field.pattern) {
    try {
      const re = new RegExp(field.pattern);
      if (!re.test(value)) return "Value does not match the expected format for " + field.envKey;
    } catch { /* bad pattern -> skip */ }
  }
  return null;
}

