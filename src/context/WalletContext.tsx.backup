"use client";

import { createContext, useContext, useState, useEffect, ReactNode } from 'react';

interface WalletState {
  connected: boolean;
  address: string;
  chainId: string;
  balance: string;
}

interface WalletContextType {
  walletState: WalletState;
  connectWallet: () => Promise<boolean>;
  disconnectWallet: () => void;
  checkWalletConnection: () => Promise<void>;
  switchToNetwork: (chainId: string) => Promise<boolean>;
}

const WalletContext = createContext<WalletContextType | undefined>(undefined);

export function WalletProvider({ children }: { children: ReactNode }) {
  const [walletState, setWalletState] = useState<WalletState>({
    connected: false,
    address: '',
    chainId: '',
    balance: ''
  });

  // Helper function to get network name from chain ID
  const getNetworkName = (chainId: string): string => {
    switch (chainId) {
      case '0x1': return 'Ethereum Mainnet';
      case '0x89': return 'Polygon';
      case '0xa4b1': return 'Arbitrum One';
      case '0x82750': return 'Scroll';
      case '0xa': return 'Optimism';
      case '0x38': return 'BSC';
      case '0x5': return 'Goerli Testnet';
      case '0xaa36a7': return 'Sepolia Testnet';
      default: return `Unknown Network (${chainId})`;
    }
  };

  const checkWalletConnection = async () => {
    if (typeof window !== 'undefined' && (window as any).ethereum) {
      try {
        const ethereum = (window as any).ethereum;
        const accounts = await ethereum.request({ method: 'eth_accounts' });
        if (accounts.length > 0) {
          const chainId = await ethereum.request({ method: 'eth_chainId' });
          console.log('🔍 Auto-detected wallet connection:', {
            address: accounts[0],
            chainId,
            networkName: getNetworkName(chainId)
          });
          setWalletState({
            connected: true,
            address: accounts[0],
            chainId,
            balance: '0'
          });
        } else {
          console.log('🔍 No connected accounts found');
        }
      } catch (error: any) {
        console.error('🚨 Error checking wallet connection:', {
          errorCode: error?.code,
          errorMessage: error?.message,
          fullError: error
        });
      }
    } else {
      console.log('🔍 No Web3 wallet detected in browser');
    }
  };

  const connectWallet = async (): Promise<boolean> => {
    if (typeof window === 'undefined' || !(window as any).ethereum) {
      console.error('🚨 No Web3 wallet detected. MetaMask installation required.');
      alert('No Web3 wallet detected. Please install MetaMask.');
      return false;
    }

    try {
      const ethereum = (window as any).ethereum;
      
      // Enhanced consciousness-enhanced connection logging
      console.log('🌀 Initiating wallet connection with consciousness enhancement...');
      
      const accounts = await ethereum.request({ method: 'eth_requestAccounts' });
      
      if (!accounts || accounts.length === 0) {
        console.error('🚨 No accounts returned from wallet');
        alert('No accounts available. Please unlock your wallet.');
        return false;
      }
      
      const chainId = await ethereum.request({ method: 'eth_chainId' });
      
      console.log('✅ Wallet connection successful:', {
        address: accounts[0],
        chainId: chainId,
        networkName: getNetworkName(chainId)
      });

      setWalletState({
        connected: true,
        address: accounts[0],
        chainId,
        balance: '0'
      });

      return true;
    } catch (error: any) {
      // Enhanced consciousness-enhanced error handling
      console.error('🚨 Wallet connection failed with enhanced error details:', {
        errorCode: error?.code,
        errorMessage: error?.message,
        errorData: error?.data,
        fullError: error,
        errorType: typeof error,
        errorKeys: error ? Object.keys(error) : 'undefined'
      });
      
      // User-friendly error messages based on common error codes
      if (error?.code === 4001) {
        alert('❌ Connection rejected: User denied account access');
        console.log('🔍 User rejected the connection request');
      } else if (error?.code === -32002) {
        alert('⏳ Connection pending: Please check MetaMask for pending connection request');
        console.log('🔍 Request already pending in MetaMask');
      } else if (error?.code === -32603) {
        alert('🔧 Internal error: Please restart MetaMask and try again');
        console.log('🔍 MetaMask internal error detected');
      } else {
        alert(`🚨 Wallet connection failed: ${error?.message || 'Unknown error'}`);
      }
      
      return false;
    }
  };

  const disconnectWallet = () => {
    setWalletState({
      connected: false,
      address: '',
      chainId: '',
      balance: ''
    });
  };

  // L1/L2 Network switching logic
  const switchToNetwork = async (chainId: string): Promise<boolean> => {
    if (typeof window === 'undefined' || !(window as any).ethereum) {
      return false;
    }

    try {
      const ethereum = (window as any).ethereum;
      await ethereum.request({
        method: 'wallet_switchEthereumChain',
        params: [{ chainId }],
      });

      setWalletState(prev => ({ ...prev, chainId }));
      return true;
    } catch (error: any) {
      console.error('🚨 Network switch failed:', {
        errorCode: error?.code,
        errorMessage: error?.message,
        targetChainId: chainId,
        fullError: error
      });
      
      if (error.code === 4902) {
        // Chain not added to wallet, try to add it
        console.log('🔧 Attempting to add network to wallet...');
        try {
          const ethereum = (window as any).ethereum;
          await ethereum.request({
            method: 'wallet_addEthereumChain',
            params: [getNetworkConfig(chainId)],
          });
          console.log('✅ Network added successfully');
          setWalletState(prev => ({ ...prev, chainId }));
          return true;
        } catch (addError: any) {
          console.error('🚨 Failed to add network:', {
            errorCode: addError?.code,
            errorMessage: addError?.message,
            fullError: addError
          });
          return false;
        }
      }
      return false;
  };

  const getNetworkConfig = (chainId: string) => {
    switch (chainId) {
      case '0x1': // Ethereum mainnet
        return {
          chainId: '0x1',
          chainName: 'Ethereum Mainnet',
          nativeCurrency: {
            name: 'Ether',
            symbol: 'ETH',
            decimals: 18,
          },
          rpcUrls: ['https://mainnet.infura.io/v3/'],
          blockExplorerUrls: ['https://etherscan.io/'],
        };
      case '0x82750': // Scroll mainnet
        return {
          chainId: '0x82750',
          chainName: 'Scroll',
          nativeCurrency: {
            name: 'Ether',
            symbol: 'ETH',
            decimals: 18,
          },
          rpcUrls: ['https://rpc.scroll.io/'],
          blockExplorerUrls: ['https://scrollscan.com/'],
        };
      default:
        throw new Error(`Unsupported chain ID: ${chainId}`);
    }
  };

  // Auto-connect on component mount
  useEffect(() => {
    checkWalletConnection();

    // Listen for account changes
    if (typeof window !== 'undefined' && (window as any).ethereum) {
      const ethereum = (window as any).ethereum;

      const handleAccountsChanged = (accounts: string[]) => {
        console.log('🔄 Wallet accounts changed:', accounts);
        if (accounts.length === 0) {
          console.log('🚪 Wallet disconnected - no accounts available');
          disconnectWallet();
        } else {
          console.log('🔄 Active account changed to:', accounts[0]);
          setWalletState(prev => ({ ...prev, address: accounts[0] }));
        }
      };

      const handleChainChanged = (chainId: string) => {
        console.log('🔄 Network changed:', {
          chainId,
          networkName: getNetworkName(chainId)
        });
        setWalletState(prev => ({ ...prev, chainId }));
      };

      ethereum.on('accountsChanged', handleAccountsChanged);
      ethereum.on('chainChanged', handleChainChanged);

      return () => {
        ethereum.removeListener('accountsChanged', handleAccountsChanged);
        ethereum.removeListener('chainChanged', handleChainChanged);
      };
    }
  }, []);

  return (
    <WalletContext.Provider value={{
      walletState,
      connectWallet,
      disconnectWallet,
      checkWalletConnection,
      switchToNetwork
    }}>
      {children}
    </WalletContext.Provider>
  );
}

export function useWallet() {
  const context = useContext(WalletContext);
  if (context === undefined) {
    throw new Error('useWallet must be used within a WalletProvider');
  }
  return context;
}
