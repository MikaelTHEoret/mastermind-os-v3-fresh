{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-core.com/protocol/mastermind-domain-event/v1.schema.json",
  "title": "Mastermind Domain Event v1",
  "$comment": "This is the cross-runtime structural wire schema. The reference runtime additionally enforces namespace/reference equality, normalized sensitive-key rejection, maximum nesting/node counts, canonical encoding, and the 64-KiB whole-event limit, which standard JSON Schema cannot fully express.",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "namespace": { "pattern": "^session/" } }, "required": ["namespace"] },
      "then": { "required": ["sessionId"] }
    },
    {
      "if": { "properties": { "namespace": { "pattern": "^world/" } }, "required": ["namespace"] },
      "then": { "required": ["worldRef"] }
    },
    {
      "if": { "properties": { "namespace": { "pattern": "^player/" } }, "required": ["namespace"] },
      "then": { "required": ["playerId"] }
    }
  ],
  "required": ["eventId", "schemaVersion", "occurredAt", "producer", "domain", "kind", "namespace", "householdId", "visibility", "payload"],
  "properties": {
    "eventId": { "$ref": "#/$defs/uuid" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "producer": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
    "domain": { "enum": ["world", "backup", "mod", "companion", "player", "workshop", "system"] },
    "kind": { "type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$" },
    "namespace": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "anyOf": [
        { "enum": ["family/shared", "companion/self", "system/technical"] },
        { "pattern": "^player/[a-z0-9][a-z0-9._:-]{0,127}/(?:private|shared)$" },
        { "pattern": "^(?:world|session|project)/[a-z0-9][a-z0-9._:-]{0,127}$" }
      ]
    },
    "householdId": { "$ref": "#/$defs/safeId" },
    "playerId": { "$ref": "#/$defs/safeId" },
    "worldRef": { "type": "string", "pattern": "^world-[a-f0-9]{64}$" },
    "sessionId": { "$ref": "#/$defs/uuid" },
    "correlationId": { "$ref": "#/$defs/uuid" },
    "visibility": { "enum": ["private", "family", "system"] },
    "payload": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": { "$ref": "#/$defs/payloadPropertyName" },
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "safeId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "payloadPropertyName": {
      "allOf": [
        { "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        { "not": { "enum": ["accessToken", "apiKey", "api_key", "authorization", "bridgeCredential", "clientSecret", "credential", "deviceCode", "password", "privateKey", "refreshToken", "secret", "sessionCookie", "token"] } }
      ]
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string", "maxLength": 4096 },
        { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "maxProperties": 128, "propertyNames": { "$ref": "#/$defs/payloadPropertyName" }, "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    }
  }
}
