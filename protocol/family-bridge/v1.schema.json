{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mastermind-core.com/protocol/family-bridge/v1.schema.json",
  "title": "Mastermind Family AI Bridge Protocol v1",
  "description": "Strict local WebSocket messages between the Family AI Fabric bridge and the local control plane.",
  "oneOf": [
    { "$ref": "#/$defs/controlHello" },
    { "$ref": "#/$defs/bridgeHello" },
    { "$ref": "#/$defs/controlReady" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/snapshot" },
    { "$ref": "#/$defs/actionExecute" },
    { "$ref": "#/$defs/actionStatus" },
    { "$ref": "#/$defs/actionCancel" },
    { "$ref": "#/$defs/clientShutdown" },
    { "$ref": "#/$defs/clientShutdownAck" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "safeCode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "registryId": {
      "type": "string",
      "pattern": "^(?!https?:|file:)[a-z0-9_.-]+:[a-z0-9_][a-z0-9_./-]*$",
      "maxLength": 128
    },
    "versionText": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+\\-]{0,63}$"
    },
    "capability": {
      "enum": [
        "state.snapshot", "action.cancel", "client.shutdown",
        "direct.say", "direct.lookAt", "direct.lookDelta", "direct.moveFor", "direct.jump", "direct.attack",
        "skill.navigateTo", "skill.followPlayer", "skill.gatherBlock", "skill.explore", "skill.escapeDanger",
        "skill.returnToKnownSafePoint"
      ]
    },
    "actionKind": {
      "enum": [
        "direct.say", "direct.lookAt", "direct.lookDelta", "direct.moveFor", "direct.jump", "direct.attack",
        "skill.navigateTo", "skill.followPlayer", "skill.gatherBlock", "skill.explore", "skill.escapeDanger",
        "skill.returnToKnownSafePoint"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/capability" }
    },
    "base": {
      "type": "object",
      "required": ["protocol", "version", "messageId", "sessionId", "seq", "sentAt", "source", "type", "payload"],
      "properties": {
        "protocol": { "const": "mastermind.family-bridge" },
        "version": { "const": 1 },
        "messageId": { "$ref": "#/$defs/uuid" },
        "sessionId": { "$ref": "#/$defs/uuid" },
        "seq": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sentAt": { "$ref": "#/$defs/timestamp" },
        "source": { "enum": ["control-plane", "family-agent-bridge"] },
        "type": { "type": "string", "minLength": 1, "maxLength": 64 },
        "payload": { "type": "object" }
      }
    },
    "controlEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "source": { "const": "control-plane" } } }
      ]
    },
    "clientEnvelope": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        { "properties": { "source": { "const": "family-agent-bridge" } } }
      ]
    },
    "controlHello": {
      "allOf": [
        { "$ref": "#/$defs/controlEnvelope" },
        {
          "properties": {
            "type": { "const": "control.hello" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["supportedVersions", "helloTimeoutMs", "heartbeatIntervalMs", "heartbeatTimeoutMs", "maxPayloadBytes"],
              "properties": {
                "supportedVersions": { "const": [1] },
                "helloTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 30000 },
                "heartbeatIntervalMs": { "type": "integer", "minimum": 250, "maximum": 30000 },
                "heartbeatTimeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000 },
                "maxPayloadBytes": { "const": 65536 }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "bridgeHello": {
      "allOf": [
        { "$ref": "#/$defs/clientEnvelope" },
        {
          "properties": {
            "type": { "const": "bridge.hello" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clientId", "pid", "bridgeVersion", "minecraftVersion", "loaderVersion", "baritoneVersion", "capabilities"],
              "properties": {
                "clientId": { "const": "family-ai-client" },
                "pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
                "bridgeVersion": { "$ref": "#/$defs/versionText" },
                "minecraftVersion": { "$ref": "#/$defs/versionText" },
                "loaderVersion": { "$ref": "#/$defs/versionText" },
                "baritoneVersion": { "$ref": "#/$defs/versionText" },
                "capabilities": { "$ref": "#/$defs/capabilities" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "controlReady": {
      "allOf": [
        { "$ref": "#/$defs/controlEnvelope" },
        {
          "properties": {
            "type": { "const": "control.ready" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heartbeatIntervalMs", "snapshotIntervalMs", "acceptedCapabilities"],
              "properties": {
                "heartbeatIntervalMs": { "type": "integer", "minimum": 250, "maximum": 30000 },
                "snapshotIntervalMs": { "type": "integer", "minimum": 250, "maximum": 30000 },
                "acceptedCapabilities": { "$ref": "#/$defs/capabilities" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "heartbeat": {
      "allOf": [
        { "$ref": "#/$defs/clientEnvelope" },
        {
          "properties": {
            "type": { "const": "bridge.heartbeat" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clientTick", "phase", "activeActionId", "killSwitch"],
              "properties": {
                "clientTick": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "phase": { "enum": ["main-menu", "connecting", "in-world", "disconnected"] },
                "activeActionId": { "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
                "killSwitch": { "type": "boolean" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -30000000, "maximum": 30000000 },
        "y": { "type": "number", "minimum": -30000000, "maximum": 30000000 },
        "z": { "type": "number", "minimum": -30000000, "maximum": 30000000 }
      }
    },
    "velocityVector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": -1024, "maximum": 1024 },
        "y": { "type": "number", "minimum": -1024, "maximum": 1024 },
        "z": { "type": "number", "minimum": -1024, "maximum": 1024 }
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "velocity", "yaw", "pitch", "health", "maxHealth", "hunger", "armor", "dimension"],
      "properties": {
        "position": { "$ref": "#/$defs/vector" },
        "velocity": { "$ref": "#/$defs/velocityVector" },
        "yaw": { "type": "number", "minimum": -180, "maximum": 180 },
        "pitch": { "type": "number", "minimum": -90, "maximum": 90 },
        "health": { "type": "number", "minimum": 0, "maximum": 2048 },
        "maxHealth": { "type": "number", "minimum": 1, "maximum": 2048 },
        "hunger": { "type": "integer", "minimum": 0, "maximum": 20 },
        "armor": { "type": "integer", "minimum": 0, "maximum": 30 },
        "dimension": { "$ref": "#/$defs/registryId" }
      }
    },
    "baritoneGoal": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "x", "y", "z"],
          "properties": {
            "kind": { "const": "block" },
            "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
            "y": { "type": "integer", "minimum": -2048, "maximum": 2048 },
            "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "playerUuid"],
          "properties": { "kind": { "const": "follow-player" }, "playerUuid": { "$ref": "#/$defs/uuid" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "radius"],
          "properties": { "kind": { "const": "explore" }, "radius": { "type": "integer", "minimum": 16, "maximum": 1024 } }
        }
      ]
    },
    "snapshotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotId", "clientTick", "phase", "serverAlias", "player", "world", "baritone", "activeAction", "safety"],
      "properties": {
        "snapshotId": { "$ref": "#/$defs/uuid" },
        "clientTick": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "phase": { "enum": ["main-menu", "connecting", "in-world", "disconnected"] },
        "serverAlias": { "enum": ["family-server", null] },
        "player": { "oneOf": [{ "$ref": "#/$defs/player" }, { "type": "null" }] },
        "world": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["timeOfDay", "weather"],
              "properties": {
                "timeOfDay": { "type": "integer", "minimum": 0, "maximum": 23999 },
                "weather": { "enum": ["clear", "rain", "thunder"] }
              }
            },
            { "type": "null" }
          ]
        },
        "baritone": {
          "type": "object", "additionalProperties": false, "required": ["state", "activeSkill", "goal"],
          "properties": {
            "state": { "enum": ["idle", "planning", "pathing", "paused", "failed"] },
            "activeSkill": { "oneOf": [{ "$ref": "#/$defs/actionKind" }, { "type": "null" }] },
            "goal": { "oneOf": [{ "$ref": "#/$defs/baritoneGoal" }, { "type": "null" }] }
          }
        },
        "activeAction": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["actionId", "kind", "status"],
              "properties": {
                "actionId": { "$ref": "#/$defs/uuid" },
                "kind": { "$ref": "#/$defs/actionKind" },
                "status": { "enum": ["started", "progress"] }
              }
            },
            { "type": "null" }
          ]
        },
        "safety": {
          "type": "object", "additionalProperties": false, "required": ["killSwitch"],
          "properties": { "killSwitch": { "type": "boolean" } }
        }
      }
    },
    "snapshot": {
      "allOf": [
        { "$ref": "#/$defs/clientEnvelope" },
        { "properties": { "type": { "const": "state.snapshot" }, "payload": { "$ref": "#/$defs/snapshotPayload" } } }
      ],
      "unevaluatedProperties": false
    },
    "action": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "direct.say" },
            "args": {
              "type": "object", "additionalProperties": false, "required": ["text"],
              "properties": { "text": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^/\\u0000-\\u001f\\u007f][^\\u0000-\\u001f\\u007f]*$" } }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "direct.lookAt" },
            "args": {
              "type": "object", "additionalProperties": false, "required": ["x", "y", "z", "durationMs"],
              "properties": {
                "x": { "type": "number", "minimum": -30000000, "maximum": 30000000 },
                "y": { "type": "number", "minimum": -2048, "maximum": 2048 },
                "z": { "type": "number", "minimum": -30000000, "maximum": 30000000 },
                "durationMs": { "type": "integer", "minimum": 50, "maximum": 5000 }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "direct.lookDelta" },
            "args": {
              "type": "object", "additionalProperties": false, "required": ["yawDelta", "pitchDelta", "durationMs"],
              "properties": {
                "yawDelta": { "type": "number", "minimum": -180, "maximum": 180 },
                "pitchDelta": { "type": "number", "minimum": -90, "maximum": 90 },
                "durationMs": { "type": "integer", "minimum": 50, "maximum": 5000 }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "direct.moveFor" },
            "args": {
              "type": "object", "additionalProperties": false,
              "required": ["forward", "strafe", "durationMs", "sprint", "sneak"],
              "properties": {
                "forward": { "type": "number", "minimum": -1, "maximum": 1 },
                "strafe": { "type": "number", "minimum": -1, "maximum": 1 },
                "durationMs": { "type": "integer", "minimum": 50, "maximum": 5000 },
                "sprint": { "type": "boolean" },
                "sneak": { "type": "boolean" }
              },
              "not": { "required": ["sprint", "sneak"], "properties": { "sprint": { "const": true }, "sneak": { "const": true } } }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "enum": ["direct.jump", "direct.attack", "skill.escapeDanger"] },
            "args": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "skill.navigateTo" },
            "args": {
              "type": "object", "additionalProperties": false, "required": ["x", "y", "z", "tolerance"],
              "properties": {
                "x": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
                "y": { "type": "integer", "minimum": -2048, "maximum": 2048 },
                "z": { "type": "integer", "minimum": -30000000, "maximum": 30000000 },
                "tolerance": { "type": "integer", "minimum": 1, "maximum": 16 }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "skill.followPlayer" },
            "args": {
              "type": "object", "additionalProperties": false, "required": ["playerUuid", "distance"],
              "properties": { "playerUuid": { "$ref": "#/$defs/uuid" }, "distance": { "type": "number", "minimum": 2, "maximum": 16 } }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "skill.gatherBlock" },
            "args": {
              "type": "object", "additionalProperties": false, "required": ["blockId", "count", "maxDistance"],
              "properties": {
                "blockId": { "$ref": "#/$defs/registryId" },
                "count": { "type": "integer", "minimum": 1, "maximum": 64 },
                "maxDistance": { "type": "integer", "minimum": 1, "maximum": 128 }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "skill.explore" },
            "args": {
              "type": "object", "additionalProperties": false, "required": ["radius"],
              "properties": { "radius": { "type": "integer", "minimum": 16, "maximum": 1024 } }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "args"],
          "properties": {
            "kind": { "const": "skill.returnToKnownSafePoint" },
            "args": {
              "type": "object", "additionalProperties": false, "required": ["safePointId"],
              "properties": { "safePointId": { "$ref": "#/$defs/safeCode" } }
            }
          }
        }
      ]
    },
    "actionExecute": {
      "allOf": [
        { "$ref": "#/$defs/controlEnvelope" },
        {
          "properties": {
            "type": { "const": "action.execute" },
            "payload": {
              "type": "object", "additionalProperties": false, "required": ["actionId", "deadlineAt", "action"],
              "properties": {
                "actionId": { "$ref": "#/$defs/uuid" },
                "deadlineAt": { "$ref": "#/$defs/timestamp" },
                "action": { "$ref": "#/$defs/action" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "progress": {
      "type": "object", "additionalProperties": false, "required": ["phase"],
      "properties": {
        "phase": { "$ref": "#/$defs/safeCode" },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "detail": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
      }
    },
    "actionStatusPayload": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["actionId", "status"],
          "properties": { "actionId": { "$ref": "#/$defs/uuid" }, "status": { "const": "started" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["actionId", "status", "progress"],
          "properties": { "actionId": { "$ref": "#/$defs/uuid" }, "status": { "const": "progress" }, "progress": { "$ref": "#/$defs/progress" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["actionId", "status", "result"],
          "properties": {
            "actionId": { "$ref": "#/$defs/uuid" }, "status": { "const": "succeeded" },
            "result": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "$ref": "#/$defs/safeCode" } } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["actionId", "status", "error"],
          "properties": {
            "actionId": { "$ref": "#/$defs/uuid" }, "status": { "const": "failed" },
            "error": {
              "type": "object", "additionalProperties": false, "required": ["code", "message"],
              "properties": {
                "code": { "$ref": "#/$defs/safeCode" },
                "message": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["actionId", "status", "cancellation"],
          "properties": {
            "actionId": { "$ref": "#/$defs/uuid" }, "status": { "const": "cancelled" },
            "cancellation": {
              "type": "object", "additionalProperties": false, "required": ["reason"],
              "properties": { "reason": { "enum": ["operator", "deadline", "shutdown", "superseded", "connection-lost", "kill-switch", "client-shutdown"] } }
            }
          }
        }
      ]
    },
    "actionStatus": {
      "allOf": [
        { "$ref": "#/$defs/clientEnvelope" },
        { "properties": { "type": { "const": "action.status" }, "payload": { "$ref": "#/$defs/actionStatusPayload" } } }
      ],
      "unevaluatedProperties": false
    },
    "actionCancel": {
      "allOf": [
        { "$ref": "#/$defs/controlEnvelope" },
        {
          "properties": {
            "type": { "const": "action.cancel" },
            "payload": {
              "type": "object", "additionalProperties": false, "required": ["actionId", "reason"],
              "properties": { "actionId": { "$ref": "#/$defs/uuid" }, "reason": { "enum": ["operator", "deadline", "shutdown", "superseded"] } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "clientShutdown": {
      "allOf": [
        { "$ref": "#/$defs/controlEnvelope" },
        {
          "properties": {
            "type": { "const": "client.shutdown" },
            "payload": {
              "type": "object", "additionalProperties": false, "required": ["shutdownId", "deadlineAt"],
              "properties": { "shutdownId": { "$ref": "#/$defs/uuid" }, "deadlineAt": { "$ref": "#/$defs/timestamp" } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "clientShutdownAck": {
      "allOf": [
        { "$ref": "#/$defs/clientEnvelope" },
        {
          "properties": {
            "type": { "const": "client.shutdownAck" },
            "payload": {
              "type": "object", "additionalProperties": false, "required": ["shutdownId", "accepted"],
              "properties": { "shutdownId": { "$ref": "#/$defs/uuid" }, "accepted": { "const": true } }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
