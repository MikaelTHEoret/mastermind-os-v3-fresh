inventory.diff","expectedError":{"message":"Inventory path contains control characters","type":"ValueError"},"id":"reject-path-tab","input":{"after":[],"before":[{"path":"src/\tfile.py","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}},{"capability":"release-inventory.diff","expectedError":{"message":"Inventory path contains control characters","type":"ValueError"},"id":"reject-path-newline","input":{"after":[],"before":[{"path":"src/\nfile.py","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}},{"capability":"release-inventory.diff","expectedError":{"message":"Inventory path contains control characters","type":"ValueError"},"id":"reject-path-del","input":{"after":[],"before":[{"path":"src/file.py","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}},{"capability":"release-inventory.diff","expected":{"added":[],"changed":[],"removed":[],"unchangedCount":1},"id":"preserve-unicode-spaces-size-only","input":{"after":[{"bytes":99,"path":"docs/Projet et mémoire/说明.md","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}],"before":[{"bytes":0,"path":"docs/Projet et mémoire/说明.md","sha256":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}]}}],"schemaVersion":1}}
